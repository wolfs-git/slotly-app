{
  "name": "slotly",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:migrate": "pnpm --filter @slotly/api db:migrate",
    "build:shared": "pnpm --filter @slotly/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm build:shared && pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
